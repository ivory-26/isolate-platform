# Environment (placeholders only — never commit real values)

# Neon PostgreSQL pooled connection string
DATABASE_URL=

# Neon Managed Better Auth (Neon Auth) — the web app's identity provider.
# The browser never talks to the auth host: the app proxies /api/auth/* and
# rewrites the session cookies onto this origin, so the SDK stays server-side.
# Base URL comes from `neon auth` (project divine-butterfly-60669535).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=        # >= 32 chars; generate with `openssl rand -base64 48`
NEON_AUTH_COOKIE_DOMAIN=         # optional; set when serving a shared parent domain
NEON_AUTH_COOKIE_SAME_SITE=lax   # strict | lax | none
NEON_AUTH_SESSION_TTL=           # optional; session data TTL in seconds
# Google sign-in is configured in Neon (Settings -> Auth -> Google). The
# dev "shared" provider needs no local credentials; production uses your own
# Google client with {NEON_AUTH_BASE_URL}/callback/google as the redirect URI
# and every app origin added to the Neon trusted-domain list.

# Offline demo mode (no database, no auth). Requires NODE_ENV=development|test.
WEB_LOCAL_DEMO=false

# Provider plane — leave EMPTY until keyed acceptance (Phase D/E).
# Policy: keys are the LAST step; see AGENTS.md §Provider credits.
# Inference split: `meta` for local/dev + pre-production agent tests;
# `baseten` for production only (Meta Muse Spark Open 1026).
INFERENCE_PROVIDER=none        # none | meta | baseten

# Meta Model API — dev/pre-production agent tests (Muse Spark 1.3 Contributor only)
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3-contributor   # only supported Meta id

# Baseten — production inference (Meta Muse Spark Open 1026 only)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
BASETEN_MAX_OUTPUT_TOKENS=16   # acceptance cap; small bounded value in product

SANDBOX_PROVIDER=null          # null | modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=isolate-platform
# Optional image override (must contain git and a POSIX shell-free toolset).
MODAL_IMAGE=
# Sandbox workspace root used by the worker's command policy (exists in the image).
WORKER_WORKSPACE_ROOT=/tmp

# Hard caps for any keyed run (stop at the first cap; never raise to pass a test)
MAX_TOKENS_PER_TASK=4096
MAX_SANDBOX_SECONDS=900
MAX_COST_USD_PER_TASK=0.50

# Worker (optional, bounded defaults)
WORKER_ID=
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5

APP_BASE_URL=http://localhost:3000
