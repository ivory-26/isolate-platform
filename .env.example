# Environment (placeholders only — never commit real values)

# Neon PostgreSQL pooled connection string
DATABASE_URL=

# Model gateway (legacy settings; the provider plane uses the block below)
MODEL_PROVIDER=groq            # groq | openrouter
LLM_API_KEY=
LLM_BASE_URL=                  # optional override
LLM_MODEL=openai/gpt-oss-120b

# Provider plane — leave EMPTY until keyed acceptance (Phase D/E).
# Policy: keys are the LAST step; see AGENTS.md §Provider credits.
INFERENCE_PROVIDER=none        # none | baseten
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open
BASETEN_MAX_OUTPUT_TOKENS=16   # acceptance cap; small bounded value in product

SANDBOX_PROVIDER=null          # null | modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hard caps for any keyed run (stop at the first cap; never raise to pass a test)
MAX_TOKENS_PER_TASK=4096
MAX_SANDBOX_SECONDS=900
MAX_COST_USD_PER_TASK=0.50

# Worker (optional, bounded defaults)
WORKER_ID=
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5

APP_BASE_URL=http://localhost:3000
