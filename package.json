{
	"name": "isolate-platform",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev:web": "cd apps/web && bun --env-file=../../.env run dev",
		"dev:worker": "cd apps/worker && bun --env-file=../../.env run dev",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"test": "bun --no-env-file test",
		"acceptance:offline": "bun --no-env-file scripts/acceptance-offline.ts",
		"acceptance:live": "bun --env-file .env scripts/acceptance-live.ts",
		"acceptance:github-write": "bun --env-file .env scripts/acceptance-live-github-write.ts",
		"acceptance:connector-live": "bun --env-file .env scripts/acceptance-connector-live.ts",
		"seed": "bun scripts/seed-workspace.ts",
		"security:check": "bun scripts/security-check.ts",
		"acceptance:k8s-local": "bun scripts/acceptance-k8s-local.ts",
		"typecheck": "bun --no-env-file scripts/typecheck-all.ts",
		"validate": "bun --no-env-file run check && bun --no-env-file run typecheck && bun --no-env-file test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"bun-types": "^1.4.4",
		"typescript": "^6.0.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["esbuild", "lightningcss"]
	}
}
