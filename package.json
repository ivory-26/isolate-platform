{
	"name": "isolate-platform",
	"private": true,
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev:web": "cd apps/web && bun --env-file=../../.env run dev",
		"dev:worker": "cd apps/worker && bun --env-file=../../.env run dev",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"test": "bun test",
		"acceptance:offline": "bun scripts/acceptance-offline.ts",
		"acceptance:live": "bun --env-file .env scripts/acceptance-live.ts",
		"typecheck": "bun scripts/typecheck-all.ts",
		"validate": "bun run check && bun run typecheck && bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"bun-types": "^1.4.4",
		"typescript": "^6.0.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["esbuild", "lightningcss"]
	}
}
